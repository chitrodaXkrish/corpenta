# Supabase — create a project and use its URL and public anon key in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Server only. Never expose this key in a NEXT_PUBLIC_ variable or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay checkout + webhook verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Secure video playback (choose and configure one provider)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
VIMEO_ACCESS_TOKEN=

# Email (Resend-compatible adapter)
EMAIL_API_KEY=
EMAIL_FROM=academy@example.com

# Telegram bot broadcasts; students must initiate/authorize the bot first.
TELEGRAM_BOT_TOKEN=

# Optional request limits and deployment support
RATE_LIMIT_REDIS_URL=
